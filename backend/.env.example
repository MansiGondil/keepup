POSTGRES_USER=keepup
POSTGRES_DB=keepup
POSTGRES_PASSWORD=change_me

# LLM used for summaries: "gemini" or "groq" (free tiers), or "fake" (offline test)
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey  (never commit the real key)
GEMINI_API_KEY=
# Optional: pin a model (see: python llm.py models)
GEMINI_MODEL=gemini-flash-lite-latest
# Free key from https://console.groq.com/keys  (never commit the real key)
GROQ_API_KEY=
# Optional: pin a model (see: python llm.py models)
GROQ_MODEL=openai/gpt-oss-20b
